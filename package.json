{
  "name": "pharma-manager-app",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "cd src/frontend && next dev",
    "build": "cd src/frontend && next build",
    "start": "cd src/frontend && next start",
    "lint": "cd src/frontend && next lint",
    "typecheck": "tsc --noEmit -p src/frontend/tsconfig.json",
    "test": "jest --config src/frontend/jest.config.cjs --runInBand",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@eslint/eslintrc": "^2.1.4",
    "next": "^14.2.30",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^20.19.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "eslint": "^8.57.1",
    "eslint-config-next": "^14.2.30",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "typescript": "^5.8.3"
  }
}
